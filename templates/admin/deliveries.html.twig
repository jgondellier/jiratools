{% extends 'base.html.twig' %}

{% block title %}Paramétrage des livraisons{% endblock %}

{% block body %}
    <h1 class="h3 mb-3"><i class="bi bi-truck"></i> Paramétrage des livraisons</h1>

    <div class="row g-3">
        <div class="col-lg-5">
            <form class="card" method="post">
                <div class="card-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('deliveries') }}">
                    <div class="mb-3">
                        <label class="form-label" for="wsProjects">Projets Jira des web services</label>
                        <textarea class="form-control" name="wsProjects" id="wsProjects" rows="3" placeholder="WS = WS&#10;WSREF = WS-REF">{{ projects_text }}</textarea>
                        <div class="form-text">
                            Une clé de projet par ligne, suivie du <strong>nom du composant tel qu'écrit dans le calendrier</strong>
                            (ex. : <code>WSREF = WS-REF</code>). Indispensable si les versions Jira ne portent que le numéro (« 1.4.2 ») :
                            c'est lui qui distingue « 1.4.2 WS » de « 1.4.2 WS-REF ». Inutile si les versions Jira s'appellent déjà « 1.4.2 WS ».
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="myComponents">Mes projets dans le calendrier <span class="text-muted">(facultatif)</span></label>
                        <textarea class="form-control" name="myComponents" id="myComponents" rows="2" placeholder="APP = PORTAIL">{{ my_components_text }}</textarea>
                        <div class="form-text">
                            Seulement si les versions Jira de vos projets ne portent que le numéro (« 1.5.0 ») alors que le calendrier
                            les écrit avec un nom (« 1.5.0 PORTAIL »). Un numéro seul n'est jamais rapproché d'une ligne d'un autre composant.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="wsLabels">Étiquette des tickets WS</label>
                        <input class="form-control" name="wsLabels" id="wsLabels" value="{{ settings.wsLabels|join(', ') }}" placeholder="ex. : ws-mon-equipe">
                        <div class="form-text">
                            Étiquette Jira que vous ajoutez sur vos tickets dans les projets WS (plusieurs possibles, séparées par des virgules).
                            Ces tickets doivent être liés à un ticket de vos projets ; un ticket WS lié mais sans l'étiquette est signalé.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="page">Page Confluence du calendrier des livraisons</label>
                        <input class="form-control" name="page" id="page" value="{{ settings.pageId }}" placeholder="URL de la page ou identifiant">
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col">
                            <label class="form-label" for="dateColumn">Colonne « date »</label>
                            <input class="form-control" name="dateColumn" id="dateColumn" value="{{ settings.dateColumn }}">
                        </div>
                        <div class="col">
                            <label class="form-label" for="versionColumn">Colonne « version »</label>
                            <input class="form-control" name="versionColumn" id="versionColumn" value="{{ settings.versionColumn }}">
                        </div>
                        <div class="form-text">Texte contenu dans l'en-tête de colonne (sans tenir compte des majuscules ni des accents).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="marginDays">Marge minimale (jours)</label>
                        <input type="number" min="0" class="form-control" name="marginDays" id="marginDays" value="{{ settings.marginDays }}" style="max-width: 120px">
                        <div class="form-text">La livraison WS doit avoir lieu au moins N jours avant la date de ma version (0 = le jour même au plus tard).</div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col">
                            <label class="form-label" for="horizonDays">Prochaines livraisons (jours)</label>
                            <input type="number" min="1" class="form-control" name="horizonDays" id="horizonDays" value="{{ settings.horizonDays }}">
                            <div class="form-text">Versions livrées dans les N prochains jours (plus les versions en retard ou sans date).</div>
                        </div>
                        <div class="col">
                            <label class="form-label" for="startDays">Démarrage au plus tard (jours ouvrés)</label>
                            <input type="number" min="0" class="form-control" name="startDays" id="startDays" value="{{ settings.startDays }}">
                            <div class="form-text">Ticket pas commencé à N jours ouvrés de la livraison : alerte rouge (orange à 2×N).</div>
                        </div>
                    </div>
                    <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Enregistrer et tester la lecture</button>
                    {% if settings.configured %}<a href="{{ path('delivery') }}" class="btn btn-outline-secondary">Voir les livraisons</a>{% endif %}
                </div>
            </form>
        </div>
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-eye"></i> Lecture de la page
                    {% if calendar and calendar.pageUrl %}: <a href="{{ calendar.pageUrl }}" target="_blank" rel="noopener">{{ calendar.pageTitle }}</a>
                        <span class="badge text-bg-secondary">{{ calendar.rows|length }} ligne(s)</span>{% endif %}
                </div>
                {% if calendar %}
                    {{ include('delivery/_calendar.html.twig', {calendar: calendar}) }}
                {% else %}
                    <div class="card-body text-muted">Renseignez la page Confluence pour voir ce qui en est extrait.</div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
