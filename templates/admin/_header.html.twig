<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-{{ icon }}"></i> {{ title }}</h1>
    <div class="d-flex gap-2">
        {% block actions %}{% endblock %}
        {% for action in actions ?? [] %}
            <a href="{{ action.url }}" class="btn btn-sm {{ action.class ?? 'btn-primary' }}"><i class="bi bi-{{ action.icon }}"></i> {{ action.label }}</a>
        {% endfor %}
    </div>
</div>
