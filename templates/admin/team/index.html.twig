{% extends 'base.html.twig' %}

{% block title %}Équipes{% endblock %}

{% block body %}
    {{ include('admin/_header.html.twig', {icon: 'people', title: 'Équipes', actions: [{url: path('admin_team_new'), icon: 'plus-lg', label: 'Nouvelle équipe'}]}) }}
    <div class="card">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Équipe</th><th>Membres</th><th>Projets</th><th>WIP max</th><th></th></tr></thead>
            <tbody>
            {% for team in teams %}
                <tr>
                    <td><span class="badge me-1" style="background: {{ team.color }}">&nbsp;</span> <strong>{{ team.name }}</strong><div class="small text-muted">{{ team.description }}</div></td>
                    <td class="small">{{ team.developers|map(d => d.displayName)|join(', ') ?: '—' }}
                        <a href="{{ path('admin_developer_new', {team: team.id}) }}" class="ms-1" title="Ajouter un membre"><i class="bi bi-person-plus"></i></a></td>
                    <td class="small">{{ team.projects|map(p => p.name)|join(', ') ?: '—' }}</td>
                    <td>{{ team.wipLimit }}</td>
                    <td class="text-end"><a href="{{ path('admin_team_edit', {id: team.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a></td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-muted py-4">Aucune équipe.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
