{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <h1 class="h4 mb-3">{{ title|capitalize }}</h1>
            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                    {{ form_widget(form) }}
                    {% if datalist is defined %}
                        <datalist id="jira-statuses">{% for s in datalist %}<option value="{{ s }}">{% endfor %}</datalist>
                    {% endif %}
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Enregistrer</button>
                        <a href="{{ app.request.query.get('redirect') ?: path(route_prefix ~ '_index') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
            {% if entity.id %}
                <form method="post" action="{{ path(route_prefix ~ '_delete', {id: entity.id}) }}" class="mt-3 text-end" data-confirm="Supprimer définitivement ?">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entity.id) }}">
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Supprimer</button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
