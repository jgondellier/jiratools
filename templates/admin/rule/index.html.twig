{% extends 'base.html.twig' %}

{% block title %}Seuils par statut{% endblock %}

{% block body %}
    {{ include('admin/_header.html.twig', {icon: 'hourglass-split', title: 'Seuils d\'alerte par statut', actions: [{url: path('admin_rule_new'), icon: 'plus-lg', label: 'Nouveau seuil'}]}) }}
    <div class="alert alert-light border small">
        <i class="bi bi-info-circle"></i> Durée maximale passée dans un statut avant alerte (en jours ; les week-ends sont exclus si <code>APP_EXCLUDE_WEEKENDS=1</code>).
        Sans règle spécifique, les statuts de la catégorie « En cours » utilisent le seuil par défaut :
        <span class="badge text-bg-warning">{{ default_warning }} j</span> / <span class="badge text-bg-danger">{{ default_critical }} j</span>
        (modifiable dans <code>.env.local</code>). Une règle liée à un projet est prioritaire sur une règle globale.
    </div>
    <div class="card">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Statut</th><th>Projet</th><th>Orange</th><th>Rouge</th><th></th></tr></thead>
            <tbody>
            {% for rule in rules %}
                <tr>
                    <td><strong>{{ rule.statusName }}</strong></td>
                    <td>{{ rule.project ? rule.project.name : 'Tous' }}</td>
                    <td><span class="badge text-bg-warning">{{ rule.warningDays }} j</span></td>
                    <td><span class="badge text-bg-danger">{{ rule.criticalDays }} j</span></td>
                    <td class="text-end"><a href="{{ path('admin_rule_edit', {id: rule.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a></td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-muted py-4">Aucune règle : seuls les seuils par défaut s'appliquent.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
