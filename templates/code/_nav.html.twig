{# Choix du projet (et du tag) commun aux écrans « Code » #}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-{{ icon }}"></i> {{ title }}</h1>
    <form class="d-flex flex-wrap gap-2 align-items-center" method="get">
        <select name="project" class="form-select form-select-sm" onchange="this.form.tag && (this.form.tag.value = ''); this.form.submit()" aria-label="Projet">
            {% for p in projects %}<option value="{{ p.id }}" {{ project and project.id == p.id ? 'selected' }}>{{ p.name }}</option>{% endfor %}
        </select>
        {% block filters %}{% endblock %}
        <button class="btn btn-sm btn-primary" name="refresh" value="1" title="Relire GitLab et Jira"><i class="bi bi-arrow-clockwise"></i></button>
    </form>
</div>
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'code_project' ? 'active' }}" href="{{ path('code_project', {project: project.id}) }}"><i class="bi bi-kanban"></i> Tickets du projet</a></li>
    <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'code_tag' ? 'active' }}" href="{{ path('code_tag', {project: project.id}) }}"><i class="bi bi-tag"></i> Contenu d'un tag</a></li>
    <li class="nav-item"><a class="nav-link" href="{{ path('release_content') }}"><i class="bi bi-git"></i> Contenu MEP (tous les dépôts)</a></li>
</ul>
