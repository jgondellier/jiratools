{% extends 'base.html.twig' %}

{% block title %}Tag {{ result.tag }} · {{ project.name }}{% endblock %}

{% block body %}
    {% embed 'code/_nav.html.twig' with {icon: 'tag', title: 'Contenu d\'un tag de version'} %}
        {% block filters %}
            <select name="tag" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Tag">
                {% for t in result.tags %}<option value="{{ t.name }}" {{ t.name == result.tag ? 'selected' }}>{{ t.name }}{{ t.date ? ' · ' ~ t.date|date('d/m/Y') }}</option>{% endfor %}
            </select>
        {% endblock %}
    {% endembed %}

    {% if result.error %}
        <div class="alert alert-danger"><i class="bi bi-x-circle" aria-hidden="true"></i> {{ result.error }}</div>
    {% else %}
        {% set scan = content.repositories|first %}
        <p class="text-muted small">
            Commits du tag <a href="{{ result.repositoryUrl }}/-/tags/{{ result.tag|url_encode }}" target="_blank" rel="noopener"><strong>{{ result.tag }}</strong></a>
            depuis {% if result.previous %}le tag précédent <strong>{{ result.previous }}</strong>{% else %}le début de l'historique{% endif %}
            {% if scan.compareUrl %}(<a href="{{ scan.compareUrl }}" target="_blank" rel="noopener">comparer dans GitLab</a>){% endif %},
            rattachés à leur merge request et à leurs tickets Jira.
            Version Jira correspondante :
            {% for name in content.targetVersions %}<span class="badge text-bg-info">{{ name }}</span> {% else %}<span class="badge text-bg-danger">aucune version du numéro {{ result.tag }}</span>{% endfor %}
        </p>

        {% if scan.error %}<div class="alert alert-danger"><i class="bi bi-x-circle" aria-hidden="true"></i> {{ scan.error }}</div>{% endif %}

        <div class="row g-3 mb-3">
            <div class="col-6 col-md"><div class="card stat-card h-100"><div class="card-body py-2">
                <div class="small"><i class="bi bi-git" aria-hidden="true"></i> Commits</div><div class="display-6">{{ commits|length }}</div>
            </div></div></div>
            <div class="col-6 col-md"><div class="card stat-card h-100 {{ without_ticket ? 'border-danger text-danger' }}"><div class="card-body py-2">
                <div class="small"><i class="bi bi-patch-question" aria-hidden="true"></i> Commits sans ticket</div><div class="display-6">{{ without_ticket }}</div>
            </div></div></div>
            <div class="col-6 col-md"><div class="card stat-card h-100"><div class="card-body py-2">
                <div class="small"><i class="bi bi-ticket-detailed" aria-hidden="true"></i> Tickets</div><div class="display-6">{{ content.tickets|length }}</div>
            </div></div></div>
            <div class="col-6 col-md"><div class="card stat-card h-100 {{ counts.error ? 'border-danger text-danger' }}"><div class="card-body py-2">
                <div class="small"><i class="bi bi-x-octagon" aria-hidden="true"></i> Jira à corriger</div><div class="display-6">{{ counts.error }}</div>
            </div></div></div>
            <div class="col-6 col-md"><div class="card stat-card h-100 {{ content.missing ? 'border-danger text-danger' }}"><div class="card-body py-2">
                <div class="small"><i class="bi bi-question-octagon" aria-hidden="true"></i> Dans la version, absents du tag</div><div class="display-6">{{ content.targetVersions ? content.missing|length : '–' }}</div>
            </div></div></div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-git" aria-hidden="true"></i> Commits du tag ({{ commits|length }})</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle small delivery-table">
                    <thead class="table-light"><tr><th>Date</th><th>Commit</th><th>Merge request</th><th>Auteur</th><th>Ticket(s) Jira</th></tr></thead>
                    <tbody>
                    {% for commit in commits %}
                        <tr class="level-row-{{ commit.ticketKeys ? 'ok' : 'error' }}">
                            <td class="text-nowrap">{{ commit.date ? commit.date|date('d/m/Y H:i') : '' }}</td>
                            <td style="min-width: 260px">
                                {% if commit.url %}<a href="{{ commit.url }}" target="_blank" rel="noopener"><code>{{ commit.shortSha }}</code></a>{% endif %}
                                {{ commit.title }}
                            </td>
                            <td>{% if commit.mr %}<a href="{{ commit.mr.url }}" target="_blank" rel="noopener">!{{ commit.mr.iid }}</a> <span class="text-muted">{{ commit.mr.sourceBranch }}</span>{% else %}<span class="text-muted">poussé directement</span>{% endif %}</td>
                            <td class="text-nowrap">{{ commit.author }}</td>
                            <td>
                                {% for key in commit.ticketKeys %}
                                    {% set t = content.tickets[key] ?? null %}
                                    <a href="{{ t and t.issue ? t.issue.url : '#' }}" target="_blank" rel="noopener" class="badge text-decoration-none {{ t and t.level == 'error' ? 'text-bg-danger' : (t and t.level == 'warning' ? 'text-bg-warning' : 'text-bg-success') }}">{{ key }}</a>
                                    {% if commit.keys is empty and commit.mr %}<span class="text-muted" title="Ticket de la merge request">(MR)</span>{% endif %}
                                {% else %}
                                    <span class="badge text-bg-danger"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Aucun ticket</span>
                                {% endfor %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-muted text-center py-3">Aucun commit entre ces deux tags.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-ticket-detailed" aria-hidden="true"></i> Tickets du tag et contrôle Jira
                {% if fix_url %}<a href="{{ fix_url }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-danger float-end"><i class="bi bi-pencil-square" aria-hidden="true"></i> Ouvrir les tickets à corriger dans Jira</a>{% endif %}
            </div>
            {{ include('release/_tickets_table.html.twig', {tickets: content.tickets, only_problems: false}) }}
        </div>

        {% if content.targetVersions %}
            <div class="card {{ content.missing ? 'border-danger' }}">
                <div class="card-header d-flex justify-content-between align-items-center gap-2">
                    <span><i class="bi bi-question-octagon" aria-hidden="true"></i> Dans la version {{ content.targetVersions|join(', ') }} mais absents du tag ({{ content.missing|length }})</span>
                    {% if version_url %}<a href="{{ version_url }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Version dans Jira</a>{% endif %}
                </div>
                {% if content.missing %}
                    <ul class="list-group list-group-flush">
                        {% for issue in content.missing %}
                            <li class="list-group-item small">
                                <a href="{{ issue.url }}" target="_blank" rel="noopener" class="fw-semibold">{{ issue.key }}</a>
                                <span class="badge {{ issue.statusBadgeClass }}">{{ issue.status }}</span> {{ issue.summary }}
                                <span class="text-muted">· {{ issue.type }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <div class="card-body small text-success"><i class="bi bi-check-circle" aria-hidden="true"></i> Tous les tickets de la version sont dans le tag.</div>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
