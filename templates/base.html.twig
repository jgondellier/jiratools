<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Pilotage{% endblock %} · Jira Tools</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧭</text></svg>">
    <link rel="stylesheet" href="{{ asset('vendor/bootstrap/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('vendor/bootstrap-icons/bootstrap-icons.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% set route = app.request.attributes.get('_route') ?? '' %}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand fw-semibold" href="{{ path('dashboard') }}"><i class="bi bi-compass"></i> Jira Tools</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link {{ route == 'dashboard' ? 'active' }}" href="{{ path('dashboard') }}"><i class="bi bi-people"></i> Qui fait quoi</a></li>
                <li class="nav-item"><a class="nav-link {{ route starts with 'sprint' ? 'active' }}" href="{{ path('sprint_index') }}"><i class="bi bi-calendar-range"></i> Sprints</a></li>
                <li class="nav-item"><a class="nav-link {{ route starts with 'backlog' ? 'active' }}" href="{{ path('backlog_index') }}"><i class="bi bi-list-task"></i> Backlog</a></li>
                <li class="nav-item"><a class="nav-link {{ route == 'delivery' ? 'active' }}" href="{{ path('delivery') }}"><i class="bi bi-truck"></i> Dépendances livraison</a></li>
                <li class="nav-item"><a class="nav-link {{ route == 'health' ? 'active' }}" href="{{ path('health') }}"><i class="bi bi-heart-pulse"></i> Suivi &amp; alertes</a></li>
                <li class="nav-item"><a class="nav-link {{ route starts with 'project_' ? 'active' }}" href="{{ path('project_index') }}"><i class="bi bi-kanban"></i> Projets</a></li>
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle {{ route starts with 'admin' ? 'active' }}" href="#" data-bs-toggle="dropdown"><i class="bi bi-gear"></i> Paramétrage</a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('admin_team_index') }}"><i class="bi bi-people"></i> Équipes</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_developer_index') }}"><i class="bi bi-person-badge"></i> Membres</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_project_index') }}"><i class="bi bi-kanban"></i> Projets</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_page_index') }}"><i class="bi bi-file-earmark-text"></i> Pages Confluence</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_work_statuses') }}"><i class="bi bi-code-slash"></i> Statuts de travail par rôle</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_deliveries') }}"><i class="bi bi-truck"></i> Dépendances livraison</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_rule_index') }}"><i class="bi bi-hourglass-split"></i> Seuils par statut</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('admin_connection') }}"><i class="bi bi-plug"></i> Tester la connexion</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container-fluid py-3 px-lg-4">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'published' ? 'success' : type }} alert-dismissible fade show" role="alert">
                {{ type == 'published' ? message|raw : message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<script src="{{ asset('vendor/bootstrap/bootstrap.bundle.min.js') }}"></script>
<script src="{{ asset('js/app.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
