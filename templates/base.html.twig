<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Pilotage{% endblock %} · Jira Tools</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><circle cx=%2216%22 cy=%2216%22 r=%2216%22 fill=%22%230d7d50%22/><path d=%22M16 6l4 10-4 10-4-10z%22 fill=%22%23fff%22/></svg>">
    <link rel="stylesheet" href="{{ asset('vendor/bootstrap/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('vendor/bootstrap-icons/bootstrap-icons.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/tokens.css') }}">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% set route = app.request.attributes.get('_route') ?? '' %}
{% set menu = [
    {route: 'dashboard', active: route == 'dashboard', icon: 'people', label: 'Qui fait quoi'},
    {route: 'sprint_index', active: route starts with 'sprint', icon: 'calendar-range', label: 'Sprints'},
    {route: 'backlog_index', active: route starts with 'backlog', icon: 'list-task', label: 'Backlog'},
    {route: 'delivery', active: route == 'delivery', icon: 'truck', label: 'Dépendances livraison'},
    {route: 'code_project', active: route == 'release_content' or route starts with 'code_', icon: 'git', label: 'Code', children: [
        {route: 'code_project', icon: 'kanban', label: 'Tickets du projet (develop / tags)'},
        {route: 'code_tag', icon: 'tag', label: 'Contenu d\'un tag'},
        {route: 'release_content', icon: 'box-seam', label: 'Contenu MEP'},
    ]},
    {route: 'health', active: route == 'health', icon: 'heart-pulse', label: 'Suivi & alertes'},
    {route: 'project_index', active: route starts with 'project_', icon: 'kanban', label: 'Projets'},
] %}
<header class="o-header navbar navbar-expand-xl sticky-top" role="banner">
    <a class="a-skipLink" href="#contenu">Aller au contenu</a>
    <div class="container-fluid px-lg-4">
        <a class="navbar-brand" href="{{ path('dashboard') }}"><span class="brand-mark" aria-hidden="true"><i class="bi bi-compass"></i></span> Jira Tools</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Afficher le menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <nav class="collapse navbar-collapse" id="nav" aria-label="Menu principal">
            <ul class="navbar-nav me-auto">
                {% for item in menu %}
                    {% if item.children ?? false %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle {{ item.active ? 'active' }}" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-{{ item.icon }}" aria-hidden="true"></i> {{ item.label }}</a>
                            <ul class="dropdown-menu">
                                {% for child in item.children %}
                                    <li><a class="dropdown-item {{ route == child.route ? 'active' }}" href="{{ path(child.route) }}"{% if route == child.route %} aria-current="page"{% endif %}><i class="bi bi-{{ child.icon }}" aria-hidden="true"></i> {{ child.label }}</a></li>
                                {% endfor %}
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item"><a class="nav-link {{ item.active ? 'active' }}" href="{{ path(item.route) }}"{% if item.active %} aria-current="page"{% endif %}><i class="bi bi-{{ item.icon }}" aria-hidden="true"></i> {{ item.label }}</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle {{ route starts with 'admin' or route starts with 'app_local_update' ? 'active' }}" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-gear" aria-hidden="true"></i> Paramétrage</a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('admin_team_index') }}"><i class="bi bi-people" aria-hidden="true"></i> Équipes</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_developer_index') }}"><i class="bi bi-person-badge" aria-hidden="true"></i> Membres</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_project_index') }}"><i class="bi bi-kanban" aria-hidden="true"></i> Projets</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_page_index') }}"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Pages Confluence</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_work_statuses') }}"><i class="bi bi-code-slash" aria-hidden="true"></i> Statuts de travail par rôle</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_deliveries') }}"><i class="bi bi-truck" aria-hidden="true"></i> Dépendances livraison</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_release_content') }}"><i class="bi bi-git" aria-hidden="true"></i> Contenu des MEP (GitLab)</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_rule_index') }}"><i class="bi bi-hourglass-split" aria-hidden="true"></i> Seuils par statut</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('admin_connection') }}"><i class="bi bi-plug" aria-hidden="true"></i> Tester la connexion</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_local_update_index') }}"><i class="bi bi-cloud-arrow-down" aria-hidden="true"></i> Mises à jour de l'application</a></li>
                    </ul>
                </li>
            </ul>
        </nav>
    </div>
</header>

<main id="contenu" class="container-fluid py-4 px-lg-4" tabindex="-1">
    {% set alert_icons = {success: 'check-circle-fill', info: 'info-circle-fill', warning: 'exclamation-triangle-fill', danger: 'x-circle-fill'} %}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} alert-dismissible d-flex align-items-start gap-2 fade show" role="{{ type in ['danger', 'warning'] ? 'alert' : 'status' }}">
                <i class="bi bi-{{ alert_icons[type] ?? 'info-circle-fill' }} mt-1" aria-hidden="true"></i>
                <div>{{ message }}</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer le message"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="o-footer" role="contentinfo">
    <div class="m-footerPrimary">
        <span class="fw-semibold">Jira Tools</span>
        <a href="{{ path('admin_connection') }}">Tester la connexion</a>
        <a href="{{ path('app_local_update_index') }}">Mises à jour de l'application</a>
    </div>
</footer>

<script src="{{ asset('vendor/bootstrap/bootstrap.bundle.min.js') }}"></script>
<script src="{{ asset('js/app.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
