<table class="table table-sm table-hover mb-0 align-middle">
    <thead class="table-light"><tr><th>Date</th><th>Réf.</th><th>Version</th><th>Fichiers</th><th>Durée</th><th>Statut</th><th></th></tr></thead>
    <tbody>
    {% for run in runs %}
        {% set files = run.summary.files ?? null %}
        <tr>
            <td class="small text-nowrap">{{ run.startedAt|date('d/m/Y H:i') }} <span class="text-muted">{{ run.trigger == 'console' ? '· console' }}</span></td>
            <td><code>{{ run.ref }}</code></td>
            <td class="small text-muted">{{ run.version ?: '—' }}</td>
            <td class="small text-nowrap">{% if files %}<span class="text-success">+{{ files.added }}</span> <span class="text-primary">~{{ files.modified }}</span> <span class="text-danger">−{{ files.deleted }}</span>{% else %}—{% endif %}</td>
            <td class="small">{{ run.durationSeconds is not null ? run.durationSeconds ~ ' s' : '' }}</td>
            <td>{{ include('local_update/_status.html.twig', {status: run.status}) }}</td>
            <td class="text-end"><a href="{{ path('app_local_update_run_show', {id: run.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-journal-text" aria-hidden="true"></i> Journal</a></td>
        </tr>
    {% else %}
        <tr><td colspan="7" class="text-center text-muted py-3">Aucune mise à jour lancée.</td></tr>
    {% endfor %}
    </tbody>
</table>
