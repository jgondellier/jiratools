{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Paramètres · Mise à jour{% endblock %}

{% block body %}
    {{ include('local_update/_header.html.twig', {icon: 'gear', title: 'Paramètres de mise à jour'}) }}
    <div class="row">
        <div class="col-xl-8">
            <p class="text-muted">Le dossier mis à jour est toujours celui de cette installation de Jira Tools ; seuls le dépôt d'origine et le déroulement se paramètrent ici.</p>
            <div class="card shadow-sm">
                <div class="card-body">
                    {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Enregistrer</button>
                        <a href="{{ path('app_local_update_index') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
