{% extends 'base.html.twig' %}

{% block title %}{{ run.app.name }} · Journal{% endblock %}

{% block body %}
    {{ include('admin/_header.html.twig', {icon: 'journal-text', title: run.app.name ~ ' — ' ~ run.startedAt|date('d/m/Y H:i'), actions: [
        {url: path('local_update_show', {id: run.app.id}), icon: 'arrow-repeat', label: 'Relancer / historique', class: 'btn-outline-primary'},
        {url: path('local_update_index'), icon: 'arrow-left', label: 'Toutes les applications', class: 'btn-outline-secondary'},
    ]}) }}

    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
        {{ include('local_update/_status.html.twig', {status: run.status}) }}
        <span>Réf. <code>{{ run.ref }}</code></span>
        {% if run.version %}<span class="text-muted">Version {{ run.version }}</span>{% endif %}
        {% if run.durationSeconds is not null %}<span class="text-muted">{{ run.durationSeconds }} s</span>{% endif %}
        {% set files = run.summary.files ?? null %}
        {% if files %}<span><span class="text-success">+{{ files.added }}</span> · <span class="text-primary">~{{ files.modified }}</span> · <span class="text-danger">−{{ files.deleted }}</span> · {{ files.unchanged }} inchangé(s)</span>{% endif %}
    </div>

    {% if run.summary.commands ?? [] %}
        <div class="card mb-3">
            <ul class="list-group list-group-flush small">
                {% for c in run.summary.commands %}
                    <li class="list-group-item d-flex justify-content-between gap-2">
                        <span class="font-monospace">{{ c.command }}</span>
                        {% if c.exitCode is null %}<span class="text-muted">non lancée (simulation)</span>
                        {% elseif c.exitCode == 0 %}<span class="text-success text-nowrap"><i class="bi bi-check-lg"></i> {{ c.seconds }} s</span>
                        {% else %}<span class="text-danger text-nowrap"><i class="bi bi-x-lg"></i> code {{ c.exitCode }}</span>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="d-flex justify-content-end mb-1">
        <button class="btn btn-sm btn-outline-secondary" data-copy-target="#run-log"><i class="bi bi-clipboard"></i> Copier</button>
    </div>
    <pre id="run-log" class="run-log">{{ run.log }}</pre>
{% endblock %}
