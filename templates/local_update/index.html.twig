{% extends 'base.html.twig' %}

{% block title %}Mises à jour locales{% endblock %}

{% block body %}
    {{ include('admin/_header.html.twig', {icon: 'cloud-arrow-down', title: 'Mises à jour locales', actions: [{url: path('local_update_new'), icon: 'plus-lg', label: 'Nouvelle application'}]}) }}
    <p class="text-muted small">Pour chaque application du poste : téléchargement du code depuis Git (archive zip), copie dans le répertoire du projet en conservant <code>.env.local</code>, <code>var/</code>, <code>vendor/</code>…, puis lancement des commandes (composer, migrations, cache:clear, import catalogue…).
        En ligne de commande : <code>php bin/console app:local-update &lt;nom&gt;</code>.</p>

    <div class="card mb-4">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Application</th><th>Dépôt</th><th>Projet</th><th>Dernière mise à jour</th><th></th></tr></thead>
            <tbody>
            {% for app in apps %}
                <tr>
                    <td><a href="{{ path('local_update_show', {id: app.id}) }}" class="fw-semibold">{{ app.name }}</a></td>
                    <td class="small"><span class="badge text-bg-secondary">{{ app.provider }}</span> {{ app.repository }} <code>{{ app.ref }}</code></td>
                    <td class="small font-monospace">{{ app.targetDirectory }}</td>
                    <td class="small">{{ include('local_update/_status.html.twig', {status: app.lastStatus}) }}
                        {% if app.lastRunAt %}<span class="text-muted">{{ app.lastRunAt|date('d/m/Y H:i') }}</span>{% endif %}</td>
                    <td class="text-end text-nowrap">
                        <a href="{{ path('local_update_show', {id: app.id}) }}" class="btn btn-sm btn-primary"><i class="bi bi-play-fill"></i> Mettre à jour</a>
                        <a href="{{ path('local_update_edit', {id: app.id}) }}" class="btn btn-sm btn-outline-secondary" title="Modifier"><i class="bi bi-pencil"></i></a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-muted py-4">Aucune application. <a href="{{ path('local_update_new') }}">Ajoutez la première</a>.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <h2 class="h5">Dernières exécutions</h2>
    <div class="card">{{ include('local_update/_runs.html.twig', {runs: runs, with_app: true}) }}</div>
{% endblock %}
