{% extends 'base.html.twig' %}

{% block title %}{{ local_app.name }} · Mise à jour{% endblock %}

{% block body %}
    {{ include('admin/_header.html.twig', {icon: 'cloud-arrow-down', title: local_app.name, actions: [
        {url: path('local_update_edit', {id: local_app.id}), icon: 'pencil', label: 'Modifier', class: 'btn-outline-secondary'},
        {url: path('local_update_index'), icon: 'arrow-left', label: 'Toutes les applications', class: 'btn-outline-secondary'},
    ]}) }}

    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <form method="post" action="{{ path('local_update_run', {id: local_app.id}) }}" class="card h-100" id="run-form">
                <div class="card-header fw-semibold"><i class="bi bi-play-circle"></i> Lancer la mise à jour</div>
                <div class="card-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('run' ~ local_app.id) }}">
                    <div class="mb-3">
                        <label class="form-label" for="ref">Branche, tag ou commit</label>
                        <input type="text" class="form-control font-monospace" id="ref" name="ref" value="{{ local_app.ref }}">
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="deploy" value="1" id="deploy" checked>
                        <label class="form-check-label" for="deploy"><strong>Télécharger le zip et le décompresser dans le projet</strong>
                            <span class="text-muted small d-block">Protégés : {{ local_app.preservedPathList|join(', ') ?: 'aucun' }}</span></label>
                    </div>
                    <div class="fw-semibold mt-3 mb-1">Commandes</div>
                    {% for i, command in commands %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="commands[]" value="{{ i }}" id="cmd{{ i }}" checked>
                            <label class="form-check-label font-monospace small" for="cmd{{ i }}" title="{{ command.expanded }}">{{ command.raw }}</label>
                        </div>
                    {% else %}
                        <p class="text-muted small">Aucune commande paramétrée.</p>
                    {% endfor %}
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" name="dry_run" value="1" id="dry_run">
                        <label class="form-check-label" for="dry_run">Simulation : lister les fichiers qui changeraient, sans rien écrire ni lancer</label>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center gap-3">
                    <button class="btn btn-primary text-nowrap" data-running-label="Mise à jour en cours…"><i class="bi bi-play-fill"></i> Lancer</button>
                    <span class="small text-muted">La page attend la fin des commandes (composer et l'import peuvent prendre plusieurs minutes).</span>
                </div>
            </form>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-clipboard-check"></i> Vérifications</div>
                <ul class="list-group list-group-flush small">
                    {% for check in checks %}
                        <li class="list-group-item d-flex gap-2">
                            <i class="bi {{ check.ok ? 'bi-check-circle-fill text-success' : 'bi-exclamation-triangle-fill text-danger' }}"></i>
                            <div class="min-w-0"><strong>{{ check.label }}</strong><div class="text-break font-monospace">{{ check.detail }}</div></div>
                        </li>
                    {% endfor %}
                    <li class="list-group-item">
                        <strong>Dernière version déployée</strong>
                        <div class="font-monospace">{{ local_app.lastVersion ?: '—' }}</div>
                        <div class="text-muted">{{ local_app.deployedFiles is null ? 'Aucun déploiement mémorisé.' : local_app.deployedFiles|length ~ ' fichiers déployés' }}</div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <h2 class="h5">Historique</h2>
    <div class="card">{{ include('local_update/_runs.html.twig', {runs: runs}) }}</div>
{% endblock %}

{% block javascripts %}
<script>
    document.getElementById('run-form').addEventListener('submit', (e) => {
        const btn = e.target.querySelector('button[data-running-label]');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> ' + btn.dataset.runningLabel;
    });
</script>
{% endblock %}
