<nav aria-label="Vous êtes ici"><ol class="breadcrumb small mb-2">
    <li class="breadcrumb-item"><a href="{{ path('app_local_update_index') }}">Mises à jour</a></li>
    {% if title is defined %}<li class="breadcrumb-item active" aria-current="page">{{ title }}</li>{% endif %}
</ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-{{ icon }} text-primary" aria-hidden="true"></i> {{ title ?? 'Mises à jour' }}</h1>
    <div class="d-flex gap-2">
        {% for action in actions ?? [] %}
            <a href="{{ action.url }}" class="btn btn-outline-{{ action.color ?? 'secondary' }}"><i class="bi bi-{{ action.icon }}" aria-hidden="true"></i> {{ action.label }}</a>
        {% endfor %}
    </div>
</div>
