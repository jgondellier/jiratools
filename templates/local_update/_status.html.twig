{% set s = status ?? null %}
{% if s == 'success' %}<span class="badge text-bg-success"><i class="bi bi-check-circle" aria-hidden="true"></i> Réussie</span>
{% elseif s == 'failed' %}<span class="badge text-bg-danger"><i class="bi bi-x-circle" aria-hidden="true"></i> En échec</span>
{% elseif s == 'running' %}<span class="badge text-bg-warning"><i class="bi bi-hourglass-split" aria-hidden="true"></i> En cours</span>
{% elseif s == 'pending' %}<span class="badge text-bg-secondary"><i class="bi bi-clock" aria-hidden="true"></i> En attente</span>
{% elseif s == 'simulated' %}<span class="badge text-bg-info"><i class="bi bi-eye" aria-hidden="true"></i> Simulation</span>
{% else %}<span class="badge text-bg-light text-muted">Jamais lancée</span>{% endif %}
