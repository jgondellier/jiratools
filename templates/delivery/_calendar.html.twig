{# Aperçu de la lecture du calendrier Confluence : variable "calendar" #}
{% if calendar.error %}
    <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle"></i> {{ calendar.error }}</div>
{% else %}
    <div class="table-responsive">
        <table class="table table-sm mb-0 align-top small">
            <thead class="table-light">
            <tr>
                <th>#</th><th>Date lue</th><th>Colonne version</th><th>Versions reconnues</th>
                <th>Autres colonnes</th>
            </tr>
            </thead>
            <tbody>
            {% for row in calendar.rows %}
                <tr class="{{ row.date ? '' : 'table-warning' }}">
                    <td class="text-muted">{{ row.number }}</td>
                    <td class="text-nowrap">
                        {% if row.date %}<strong>{{ row.date|date('d/m/Y') }}</strong>{% else %}<span class="text-danger"><i class="bi bi-question-circle"></i> illisible</span>{% endif %}
                        {% if row.rawDate and (not row.date or row.rawDate != row.date|date('Y-m-d')) %}<div class="text-muted">« {{ row.rawDate }} »</div>{% endif %}
                    </td>
                    <td class="text-muted">{% for line in row.versionLines %}<div>{{ line }}</div>{% endfor %}</td>
                    <td>
                        {% for entry in row.entries %}
                            <span class="badge text-bg-light border text-dark fw-normal me-1 mb-1"><strong>{{ entry.version }}</strong>{% if entry.component %} · {{ entry.component }}{% else %} <span class="text-warning-emphasis" title="Aucun composant à côté du numéro">· ?</span>{% endif %}</span>
                        {% else %}
                            <span class="text-warning-emphasis"><i class="bi bi-exclamation-triangle"></i> aucun numéro de version</span>
                        {% endfor %}
                    </td>
                    <td class="text-muted">{% for header, value in row.otherCells %}{% if value %}<div><strong>{{ header }} :</strong> {{ value }}</div>{% endif %}{% endfor %}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-muted text-center py-3">Tableau trouvé mais vide.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
