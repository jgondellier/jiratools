{% extends 'base.html.twig' %}

{% block title %}Contenu de la MEP{% endblock %}


{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0"><i class="bi bi-git" aria-hidden="true"></i> Contenu de la MEP</h1>
        <form class="d-flex flex-wrap gap-2 align-items-center" method="get" id="release-form">
            <input type="hidden" name="v" value="1">
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    {% if content.targetVersions %}Version : {{ content.targetVersions|join(', ') }}{% else %}Aucune version choisie{% endif %}
                </button>
                <div class="dropdown-menu dropdown-menu-end p-2" style="min-width: 280px; max-height: 420px; overflow: auto">
                    {% for v in content.candidates %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="versions[]" value="{{ v.id }}" id="v{{ v.id }}" {{ content.targetVersions[v.id] is defined ? 'checked' }}>
                            <label class="form-check-label small" for="v{{ v.id }}">
                                <strong>{{ v.projectKey }}</strong> {{ v.name }}
                                <span class="text-muted">{{ v.releaseDate ? v.releaseDate|date('d/m/Y') : 'sans date' }}</span>
                            </label>
                        </div>
                    {% else %}
                        <div class="small text-muted">Aucune version non livrée dans vos projets Jira.</div>
                    {% endfor %}
                    <button class="btn btn-sm btn-primary mt-2 w-100">Appliquer</button>
                </div>
            </div>
            <div class="form-check form-switch text-nowrap">
                <input class="form-check-input" type="checkbox" name="problems" value="1" id="problems" {{ only_problems ? 'checked' }} onchange="this.form.submit()">
                <label class="form-check-label small" for="problems">Problèmes uniquement</label>
            </div>
            <button class="btn btn-sm btn-primary" name="refresh" value="1" title="Relire GitLab et Jira"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
            <a href="{{ path('admin_release_content') }}" class="btn btn-sm btn-outline-secondary" title="Paramétrage"><i class="bi bi-gear" aria-hidden="true"></i></a>
        </form>
    </div>

    <p class="text-muted small mb-3">
        Code de la branche <code>{{ settings.branch }}</code> pas encore en production
        (<code>{{ settings.reference ?: 'dernier tag' }}</code>), d'après les merge requests et commits GitLab,
        comparé à Jira{% if content.targetVersions %} et à la version <strong>{{ content.targetVersions|join(', ') }}</strong>{% endif %}.
    </p>

    {% for scan in content.repositoryErrors %}
        <div class="alert alert-danger py-2"><i class="bi bi-x-circle" aria-hidden="true"></i> <strong>{{ scan.label }}</strong> : {{ scan.error }}</div>
    {% endfor %}

    <div class="row g-3 mb-3">
        <div class="col-6 col-md">
            <div class="card stat-card h-100"><div class="card-body py-2">
                <div class="small"><i class="bi bi-ticket-detailed" aria-hidden="true"></i> Tickets dans le code</div><div class="display-6">{{ content.tickets|length }}</div>
            </div></div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card h-100 {{ counts.error ? 'border-danger text-danger' }}"><div class="card-body py-2">
                <div class="small"><i class="bi bi-x-octagon" aria-hidden="true"></i> Jira à corriger</div><div class="display-6">{{ counts.error }}</div>
            </div></div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card h-100 {{ counts.warning ? 'border-warning' }}"><div class="card-body py-2">
                <div class="small"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> À vérifier</div><div class="display-6">{{ counts.warning }}</div>
            </div></div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card h-100 {{ content.missing ? 'border-danger text-danger' }}"><div class="card-body py-2">
                <div class="small"><i class="bi bi-question-octagon" aria-hidden="true"></i> Dans la version, sans code</div><div class="display-6">{{ content.targetVersions ? content.missing|length : '–' }}</div>
            </div></div>
        </div>
        <div class="col-6 col-md">
            <div class="card stat-card h-100 {{ content.untracked ? 'border-warning' }}"><div class="card-body py-2">
                <div class="small"><i class="bi bi-patch-question" aria-hidden="true"></i> MR / commits sans ticket</div><div class="display-6">{{ content.untracked|length }}</div>
            </div></div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span><i class="bi bi-ticket-detailed" aria-hidden="true"></i> Tickets livrés par cette MEP</span>
            <span class="d-flex gap-2">
                {% if fix_url %}<a href="{{ fix_url }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-danger"><i class="bi bi-pencil-square" aria-hidden="true"></i> Ouvrir les tickets à corriger dans Jira</a>{% endif %}
                {% if all_url %}<a href="{{ all_url }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Tous dans Jira</a>{% endif %}
            </span>
        </div>
        {{ include('release/_tickets_table.html.twig') }}
        </div>
    </div>

    {% if content.targetVersions %}
        <div class="card mb-3 {{ content.missing ? 'border-danger' }}">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><i class="bi bi-question-octagon" aria-hidden="true"></i> Dans la version {{ content.targetVersions|join(', ') }} mais sans merge request ni commit ({{ content.missing|length }})</span>
                {% if version_url %}<a href="{{ version_url }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Version dans Jira</a>{% endif %}
            </div>
            {% if content.missing %}
                <div class="card-body small pb-1">
                    Ces tickets sont annoncés dans la version mais leur code n'est pas dans <code>{{ settings.branch }}</code> :
                    pas encore fusionné, commit sans la clé du ticket, ou ticket sans code (paramétrage, documentation…). À retirer de la version s'ils ne partent pas.
                </div>
                <ul class="list-group list-group-flush">
                    {% for issue in content.missing %}
                        <li class="list-group-item small">
                            <a href="{{ issue.url }}" target="_blank" rel="noopener" class="fw-semibold">{{ issue.key }}</a>
                            <span class="badge {{ issue.statusBadgeClass }}">{{ issue.status }}</span>
                            {{ issue.summary }}
                            <span class="text-muted">· {{ issue.type }}{{ issue.assigneeName ? ' · ' ~ issue.assigneeName }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <div class="card-body small text-success"><i class="bi bi-check-circle" aria-hidden="true"></i> Tous les tickets de la version sont dans le code.</div>
            {% endif %}
        </div>
    {% endif %}

    <div class="card mb-3">
        <div class="card-header"><i class="bi bi-patch-question" aria-hidden="true"></i> Merge requests et commits sans ticket ({{ content.untracked|length }})</div>
        {% if content.untracked %}
            <ul class="list-group list-group-flush">
                {% for item in content.untracked %}
                    <li class="list-group-item small">
                        <i class="bi bi-{{ item.type == 'mr' ? 'sign-merge-left' : 'git' }}" aria-hidden="true"></i>
                        <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.label }}</a>
                        {% if item.detail %}<code class="ms-1">{{ item.detail }}</code>{% endif %}
                        <span class="text-muted">· {{ item.author }}{{ item.date ? ' · ' ~ item.date|date('d/m/Y') }}{% if content.repositories|length > 1 %} · {{ item.repository }}{% endif %}</span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <div class="card-body small text-success"><i class="bi bi-check-circle" aria-hidden="true"></i> Tout le code est rattaché à un ticket.</div>
        {% endif %}
    </div>

    <div class="card">
        <div class="card-header"><i class="bi bi-git" aria-hidden="true"></i> Dépôts lus</div>
        <ul class="list-group list-group-flush">
            {% for scan in content.repositories %}
                <li class="list-group-item small">
                    <strong>{% if scan.webUrl %}<a href="{{ scan.webUrl }}" target="_blank" rel="noopener">{{ scan.label }}</a>{% else %}{{ scan.path }}{% endif %}</strong>
                    {% if scan.error %}
                        <span class="text-danger">— {{ scan.error }}</span>
                    {% else %}
                        — <code>{{ scan.reference }}..{{ scan.branch }}</code> : {{ scan.commitCount }} commit(s), {{ scan.mergeRequests|length }} merge request(s), {{ scan.directCommits|length }} commit(s) hors merge request
                        {% if scan.compareUrl %}· <a href="{{ scan.compareUrl }}" target="_blank" rel="noopener">comparer</a>{% endif %}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        <div class="card-footer small text-muted">Clés reconnues : {{ content.projectKeys|join(', ') ?: 'toute clé en majuscules' }}</div>
    </div>
{% endblock %}
