{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Sprint · {{ project.name }}{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0"><i class="bi bi-calendar-range"></i> {{ project.name }}{% if report %} · {{ report.sprint.name }}{% endif %}</h1>
        <form class="d-flex gap-2" method="get">
            <select name="sprint" class="form-select form-select-sm" onchange="this.form.submit()">
                {% for s in sprints %}
                    <option value="{{ s.id }}" {{ report and report.sprint.id == s.id ? 'selected' }}>{{ s.name }}{{ s.active ? ' (en cours)' : '' }}</option>
                {% endfor %}
            </select>
            {% if report and report.boardUrl %}<a href="{{ report.boardUrl }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary text-nowrap"><i class="bi bi-box-arrow-up-right"></i> Board</a>{% endif %}
        </form>
    </div>

    {% if not project.jiraBoardId %}
        <div class="alert alert-warning">Aucun board Scrum paramétré pour ce projet. <a href="{{ path('admin_project_edit', {id: project.id}) }}">Renseigner l'identifiant du board</a></div>
    {% elseif not report %}
        <div class="alert alert-info">Aucun sprint actif sur ce board.</div>
    {% else %}
        <div class="row g-3 mb-3">
            <div class="col-lg-4">{{ include('sprint/_card.html.twig', {report: report}) }}</div>
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header">Charge par personne</div>
                    <ul class="list-group list-group-flush">
                        {% for load in report.loadByAssignee %}
                            <li class="list-group-item d-flex align-items-center gap-2">
                                {{ ui.avatar(load.name, load.avatar, 28) }}
                                <span class="flex-grow-1">{{ load.name }}</span>
                                <span class="badge text-bg-secondary" title="À faire">{{ load.todo }}</span>
                                <span class="badge text-bg-primary" title="En cours">{{ load.inProgress }}</span>
                                <span class="badge text-bg-success" title="Terminés">{{ load.done }}</span>
                                {% if report.usesPoints %}<span class="badge text-bg-info" title="Points restants">{{ load.remainingPoints }} pts</span>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header">Vélocité des derniers sprints <small class="text-muted">(terminés avant clôture)</small></div>
                    <div class="card-body">
                        {% if velocity is empty %}
                            <p class="text-muted small">Aucun sprint clôturé.</p>
                        {% else %}
                            {% set useP = velocity|filter(v => v.points > 0)|length > 0 %}
                            {% set maxV = max(velocity|map(v => useP ? v.points : v.done)|merge([1])) %}
                            <div class="velocity-bar mt-3">
                                {% for v in velocity %}
                                    {% set val = useP ? v.points : v.done %}
                                    <div class="bar" style="height: {{ (val / maxV * 100)|round }}%" title="{{ v.sprint.name }} : {{ v.done }}/{{ v.total }} tickets, {{ v.points }} pts"><span>{{ val }}</span></div>
                                {% endfor %}
                            </div>
                            <div class="d-flex gap-2 small text-muted mt-1">
                                {% for v in velocity %}<div class="flex-fill text-center text-truncate" style="flex:1">{{ v.sprint.name|split(' ')|last }}</div>{% endfor %}
                            </div>
                            {% set avg = (velocity|map(v => useP ? v.points : v.done)|reduce((c, x) => c + x, 0)) / velocity|length %}
                            <p class="small mb-0 mt-2">Moyenne : <strong>{{ avg|round(1) }}</strong> {{ useP ? 'points' : 'tickets' }} / sprint</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {% if report.unestimated is not empty %}
            <div class="alert alert-warning py-2 small"><i class="bi bi-question-circle"></i> {{ report.unestimated|length }} ticket(s) non estimé(s) dans ce sprint :
                {% for v in report.unestimated %}<a href="{{ v.issue.url }}" target="_blank" rel="noopener">{{ v.issue.key }}</a>{{ not loop.last ? ', ' }}{% endfor %}
            </div>
        {% endif %}

        <div class="row g-3">
            {% for status, views in report.issuesByStatus %}
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between">
                            <span>{{ ui.status_badge(views[0].issue) }}</span><span class="text-muted small">{{ views|length }}</span>
                        </div>
                        <div class="card-body">
                            {% for view in views %}{{ ui.issue_line(view, {project: false, assignee: true}) }}{% endfor %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
