<h1 class="h4">{{ title }}</h1>
{% for label, issues in groups %}
    <h2>{{ label|humanize_label }} <small class="text-muted">({{ issues|length }})</small></h2>
    <ul>
        {% for issue in issues %}
            <li>
                {% if issue.isBug %}<span title="Correction">🐞</span>{% endif %}
                <a href="{{ issue.url }}" target="_blank" rel="noopener">{{ issue.key }}</a> {{ issue.summary }}
                {% if not issue.isDone %}<span class="badge text-bg-warning">{{ issue.status }}</span>{% endif %}
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p class="text-muted">Aucun ticket.</p>
{% endfor %}
