{% extends 'base.html.twig' %}

{% block title %}Release note{% endblock %}

{% block body %}
    <h1 class="h3 mb-3"><i class="bi bi-megaphone"></i> Release note</h1>

    <form class="card mb-3" method="get">
        <div class="card-body row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Projet</label>
                <select name="project" class="form-select" onchange="this.form.querySelectorAll('select[name=version],select[name=sprint]').forEach(s => s.value=''); this.form.submit()">
                    {% for p in projects %}<option value="{{ p.id }}" {{ p.id == project.id ? 'selected' }}>{{ p.name }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Version (fixVersion)</label>
                <select name="version" class="form-select">
                    <option value="">—</option>
                    {% for v in versions %}
                        <option value="{{ v.name }}" {{ version == v.name ? 'selected' }}>{{ v.name }}{{ v.released ? ' ✔' : '' }}{{ v.releaseDate ? ' (' ~ v.releaseDate|date('d/m/Y') ~ ')' : '' }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">ou sprint</label>
                <select name="sprint" class="form-select">
                    <option value="">—</option>
                    {% for s in sprints %}<option value="{{ s.id }}" {{ sprint_id == s.id ? 'selected' }}>{{ s.name }}{{ s.active ? ' (en cours)' : '' }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check">
                    <input type="hidden" name="onlyDone" value="0">
                    <input class="form-check-input" type="checkbox" name="onlyDone" value="1" id="onlyDone" {{ only_done ? 'checked' }}>
                    <label class="form-check-label small" for="onlyDone">Tickets terminés uniquement</label>
                </div>
            </div>
            <div class="col-md-1">
                <button class="btn btn-primary w-100"><i class="bi bi-magic"></i> Générer</button>
            </div>
        </div>
    </form>

    {% if result %}
        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ result.issues|length }} ticket(s) · {{ result.groups|length }} sujet(s)</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-target="#release-note-html"><i class="bi bi-clipboard"></i> Copier (mise en forme)</button>
                    </div>
                    <div class="card-body release-note" id="release-note-html" data-copy-html>
                        {{ include('release_note/_content.html.twig', {groups: result.groups, title: title}) }}
                    </div>
                    <div class="card-footer small text-muted"><code>{{ result.jql }}</code></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card mb-3">
                    <div class="card-header"><i class="bi bi-cloud-upload"></i> Publier dans Confluence</div>
                    <form class="card-body" method="post" action="{{ path('release_note_publish') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('publish') }}">
                        <input type="hidden" name="project" value="{{ project.id }}">
                        <input type="hidden" name="version" value="{{ version }}">
                        <input type="hidden" name="sprint" value="{{ sprint_id }}">
                        <input type="hidden" name="onlyDone" value="{{ only_done ? 1 : 0 }}">
                        <div class="mb-2">
                            <label class="form-label small">Titre de la page</label>
                            <input name="title" class="form-control form-control-sm" value="{{ title }}">
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Espace Confluence</label>
                            <input name="space" class="form-control form-control-sm" value="{{ project.confluenceSpaceKey }}" placeholder="ex. : APP" required>
                        </div>
                        <p class="small text-muted">
                            {% if project.releaseNoteParentPageId %}Page créée sous la page parente n° {{ project.releaseNoteParentPageId }}.{% else %}Aucune page parente paramétrée : la page sera créée à la racine de l'espace.{% endif %}
                            Si une page du même titre existe, elle est mise à jour.
                        </p>
                        <button class="btn btn-success w-100"><i class="bi bi-cloud-upload"></i> Publier</button>
                    </form>
                </div>
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        Markdown
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-target="#release-note-md"><i class="bi bi-clipboard"></i> Copier</button>
                    </div>
                    <pre class="markdown mb-0 small" id="release-note-md">{{ markdown }}</pre>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">
            Choisissez une version ou un sprint. Les tickets sont regroupés par <strong>étiquette</strong> (un sujet = une étiquette) ;
            les tickets sans étiquette sont rangés dans « Autres évolutions ». Les anomalies sont listées après les évolutions dans chaque sujet.
        </div>
    {% endif %}
{% endblock %}
