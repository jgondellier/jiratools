# Valeurs par défaut. NE METTEZ PAS VOS JETONS ICI : copiez les lignes utiles
# dans un fichier .env.local (non versionné) et renseignez-les.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-env-local
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# MySQL / MariaDB fourni par EasyPHP (utilisateur root sans mot de passe par défaut)
DATABASE_URL="mysql://root:@127.0.0.1:3306/jiratools?serverVersion=8.0.32&charset=utf8mb4"
# MariaDB : DATABASE_URL="mysql://root:@127.0.0.1:3306/jiratools?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# Sans serveur de base de données (extension pdo_sqlite requise) :
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> Jira ###
# Cloud : https://votre-site.atlassian.net   | Server/DC : https://jira.mon-entreprise.fr
JIRA_BASE_URL=
# Cloud : votre e-mail (+ API token créé sur https://id.atlassian.com/manage-profile/security/api-tokens)
# Server/DC : laisser vide et mettre un Personal Access Token dans JIRA_API_TOKEN
JIRA_USER=
JIRA_API_TOKEN=
# auto (détecte *.atlassian.net), cloud ou server
JIRA_DEPLOYMENT=auto
# Champs personnalisés (Administration Jira > Champs personnalisés, ou /rest/api/2/field)
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_SPRINT_FIELD=customfield_10020
JIRA_FLAGGED_FIELD=customfield_10021
# Statuts "terminés" (utilisés pour détecter les tickets réouverts)
JIRA_DONE_STATUSES="Done,Terminé,Closed,Fermé"
###< Jira ###

###> Confluence ###
# Cloud : https://votre-site.atlassian.net/wiki  | Server/DC : https://confluence.mon-entreprise.fr
CONFLUENCE_BASE_URL=
CONFLUENCE_USER=
CONFLUENCE_API_TOKEN=
###< Confluence ###

###> Application ###
APP_TIMEZONE=Europe/Paris
# Durée de cache des appels Jira/Confluence (secondes). Ajoutez ?refresh=1 pour forcer.
APP_CACHE_TTL=60
# Rafraîchissement automatique du tableau "Qui fait quoi" (secondes, 0 = désactivé)
APP_REFRESH_SECONDS=120
# Les durées dans un statut excluent les samedis et dimanches
APP_EXCLUDE_WEEKENDS=1
# Seuils par défaut pour les statuts "En cours" sans règle spécifique (en jours)
STATUS_DEFAULT_WARNING_DAYS=3
STATUS_DEFAULT_CRITICAL_DAYS=5
# Étiquettes ignorées dans la release note (séparées par des virgules)
RELEASE_NOTE_IGNORED_LABELS=
###< Application ###

###> Connexion HTTP (Jira et Confluence) ###
# Vérification du certificat SSL du serveur. Plutôt que de la désactiver (0),
# préférez indiquer le certificat de l'autorité interne dans APP_HTTP_CAFILE.
APP_HTTP_VERIFY_PEER=1
# Vérification que le nom du serveur correspond au certificat
APP_HTTP_VERIFY_HOST=1
# Fichier des autorités de certification (PEM), ex. : C:/EasyPHP/certs/ca-entreprise.pem
APP_HTTP_CAFILE=
# Proxy sortant, ex. : http://proxy.entreprise.fr:8080 (ou http://user:mdp@proxy:8080)
APP_HTTP_PROXY=
# Hôtes à joindre sans proxy, séparés par des virgules, ex. : localhost,.intranet.fr
APP_HTTP_NO_PROXY=
# Délai maximal sans réponse (secondes)
APP_HTTP_TIMEOUT=30
###< Connexion HTTP ###
